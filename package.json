{
  "name": "aula-f75-studio",
  "productName": "AULA F75 Studio",
  "version": "1.0.0",
  "description": "AULA F75 için 60+ yeni RGB animasyonu, canlı önizleme ve donanım kontrolü",
  "author": "AULA F75 Studio",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc --noEmit && vite build",
    "start": "npm run build:web && electron .",
    "electron": "electron .",
    "dist": "npm run build:web && electron-builder --win --x64",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/w3c-web-hid": "^1.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.aulaf75.studio",
    "productName": "AULA F75 Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AULA F75 Studio",
      "artifactName": "AULA-F75-Studio-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "AULA-F75-Studio-Portable-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "uiohook-napi@1.5.5": true,
    "esbuild@0.25.12": true
  }
}
